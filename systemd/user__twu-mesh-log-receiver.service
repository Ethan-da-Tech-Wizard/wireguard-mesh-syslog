# ==============================================================================
# Program: systemd/user__twu-mesh-log-receiver.service
# Programmer: Ethan-da-Tech-Wizard
# Last Modified: November 18, 2026
# Purpose: Systemd user service unit rooted at %h/workspace for non-root execution
#          of the WireGuard remote syslog receiver with cgroup v2 resource limits
#          and Linux kernel security hardening.
# ==============================================================================

[Unit]
Description=TWU WireGuard mesh remote syslog receiver for outside nodes (Lynis LOGG-2154)
Documentation=https://github.com/Ethan-da-Tech-Wizard/wireguard-mesh-syslog
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace
ExecStart=/usr/bin/python3 -B scripts/mesh_log_receiver.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# CPU Scheduling & Hardware Resource Containment (cgroup v2):
Nice=19
CPUQuota=25%
MemoryMax=512M

# Linux Kernel Hardening & Security Sandbox:
NoNewPrivileges=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
